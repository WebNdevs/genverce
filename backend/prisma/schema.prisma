generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String         @id @default(uuid())
  name                      String
  email                     String         @unique
  password                  String
  role                      Role           @default(CUSTOMER)
  accountType               AccountType    @default(INDIVIDUAL)
  avatar                    String?
  company                   String?
  isActive                  Boolean        @default(true)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  username                  String?        @unique
  brandName                 String?
  isOnboarded               Boolean        @default(false)
  productName               String?
  targetAudience            String?        @db.Text
  tone                      String?
  website                   String?
  requestedCustomInfluencer Boolean        @default(false)
  industry                  String?
  contentTypes              Json?
  goal                      String?
  platforms                 Json?
  deletedAt                 DateTime?
  chatNotes                 ChatNote[]
  chats                     Chat[]
  notifications             Notification[]
  orders                    Order[]
  payments                  Payment[]
  reviews                   Review[]
  tickets                   Ticket[]

  @@map("users")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?  @db.Text
  href        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "notifications_userId_fkey")
  @@map("notifications")
}

model Influencer {
  id                String                @id @default(uuid())
  name              String
  bio               String
  avatar            String
  coverImage        String?
  industries        Json
  contentStyle      String
  languages         Json
  rating            Float                 @default(0)
  totalProjects     Int                   @default(0)
  totalReviews      Int                   @default(0)
  isActive          Boolean               @default(true)
  hourlyRate        Float?
  systemPrompt      String                @db.Text
  voiceId           String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  serviceType       InfluencerServiceType @default(CHAT_ONLY)
  outOfTopicMessage String?               @db.Text
  topic             String?               @db.Text
  locationAddress   String?               @db.Text
  locationCity      String?
  locationCountry   String?
  locationPincode   String?
  locationState     String?
  deletedAt         DateTime?
  aiConfig          AIConfig?
  chats             Chat[]
  packages          InfluencerPackage[]
  portfolio         InfluencerPortfolio[]
  orders            Order[]
  reviews           Review[]

  @@map("influencers")
}

model AIConfig {
  id           String     @id @default(uuid())
  influencerId String     @unique
  scriptApiUrl String?
  scriptApiKey String?
  scriptModel  String?
  voiceApiUrl  String?
  voiceApiKey  String?
  voiceModel   String?
  videoApiUrl  String?
  videoApiKey  String?
  videoModel   String?
  imageApiUrl  String?
  imageApiKey  String?
  imageModel   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  postApiKey   String?
  postApiUrl   String?
  postModel    String?
  chatApiKey   String?
  chatApiUrl   String?
  chatModel    String?
  chatProvider String?
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@map("ai_configs")
}

model InfluencerPortfolio {
  id           String     @id @default(uuid())
  influencerId String
  videoUrl     String
  thumbnailUrl String
  title        String
  description  String?
  createdAt    DateTime   @default(now())
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId], map: "influencer_portfolios_influencerId_fkey")
  @@map("influencer_portfolios")
}

model InfluencerPackage {
  id           String      @id @default(uuid())
  influencerId String
  type         PackageType
  name         String
  price        Float
  videoCount   Int
  description  String?     @db.Text
  isMonthly    Boolean     @default(false)
  isActive     Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  influencer   Influencer  @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId, type])
  @@index([influencerId])
  @@map("influencer_packages")
}

model Chat {
  id           String      @id @default(uuid())
  customerId   String
  influencerId String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  memory       ChatMemory?
  notes        ChatNote[]
  customer     User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  influencer   Influencer  @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([customerId, influencerId])
  @@index([influencerId], map: "chats_influencerId_fkey")
  @@map("chats")
}

model Message {
  id        String      @id @default(uuid())
  chatId    String
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now())
  imageUrl  String?     @db.Text
  chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId], map: "messages_chatId_fkey")
  @@map("messages")
}

model ChatMemory {
  id           String   @id @default(uuid())
  chatId       String   @unique
  customerId   String
  influencerId String
  details      Json
  facts        Json
  snippets     Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  chat         Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("chat_memories")
}

model ChatNote {
  id        String   @id @default(uuid())
  chatId    String
  userId    String
  title     String?
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId], map: "chat_notes_chatId_fkey")
  @@index([userId], map: "chat_notes_userId_fkey")
  @@map("chat_notes")
}

model SiteSettings {
  id           String   @id @default("global")
  chatApiUrl   String?
  chatApiKey   String?
  chatModel    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  chatProvider String?

  @@map("site_settings")
}

model FaqEntry {
  id        String   @id @default(uuid())
  question  String   @db.Text
  keywords  String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  answers   Json

  @@map("faq_entries")
}

model Order {
  id              String       @id @default(uuid())
  customerId      String
  influencerId    String
  projectBrief    String       @db.LongText
  package         PackageType
  deliveryType    DeliveryType @default(QUALITY_CHECKED)
  status          OrderStatus  @default(PENDING_PAYMENT)
  price           Float
  videoUrl        String?
  thumbnailUrl    String?
  aiDisclosure    Boolean      @default(true)
  reviewNotes     String?
  reviewedBy      String?
  reviewedAt      DateTime?
  deliveredAt     DateTime?
  videosOrdered   Int          @default(1)
  videosDelivered Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  customer        User         @relation(fields: [customerId], references: [id])
  influencer      Influencer   @relation(fields: [influencerId], references: [id])
  payment         Payment?
  review          Review?
  ticket          Ticket?

  @@index([customerId], map: "orders_customerId_fkey")
  @@index([influencerId], map: "orders_influencerId_fkey")
  @@map("orders")
}

model Review {
  id           String     @id @default(uuid())
  orderId      String     @unique
  customerId   String
  influencerId String
  rating       Float
  comment      String?    @db.Text
  createdAt    DateTime   @default(now())
  customer     User       @relation(fields: [customerId], references: [id])
  influencer   Influencer @relation(fields: [influencerId], references: [id])
  order        Order      @relation(fields: [orderId], references: [id])

  @@index([customerId], map: "reviews_customerId_fkey")
  @@index([influencerId], map: "reviews_influencerId_fkey")
  @@map("reviews")
}

model Ticket {
  id         String       @id @default(uuid())
  customerId String
  orderId    String?      @unique
  issue      String       @db.Text
  status     TicketStatus @default(OPEN)
  resolution String?      @db.Text
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  reopenNote String?      @db.Text
  customer   User         @relation(fields: [customerId], references: [id])
  order      Order?       @relation(fields: [orderId], references: [id])

  @@index([customerId], map: "tickets_customerId_fkey")
  @@map("tickets")
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @unique
  customerId      String
  stripePaymentId String?       @unique
  amount          Float
  currency        String        @default("usd")
  status          PaymentStatus @default(PENDING)
  refundedAmount  Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        User          @relation(fields: [customerId], references: [id])
  order           Order         @relation(fields: [orderId], references: [id])

  @@index([customerId], map: "payments_customerId_fkey")
  @@map("payments")
}

enum Role {
  CUSTOMER
  AGENCY
  ADMIN
  REVIEWER
}

enum AccountType {
  INDIVIDUAL
  AGENCY
}

enum InfluencerServiceType {
  CHAT_ONLY
  VIDEO_CREATION
  POST_CREATION
  IMAGE_CREATION
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  GENERATING
  PENDING_REVIEW
  APPROVED
  DELIVERED
  REJECTED
  REFUNDED
  CANCELLED
}

enum PackageType {
  SINGLE
  PACK_5
  PACK_10
  MONTHLY_STARTER
  MONTHLY_GROWTH
  CUSTOM
}

enum DeliveryType {
  INSTANT
  QUALITY_CHECKED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}
