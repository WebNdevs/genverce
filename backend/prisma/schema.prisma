generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════
// USER & AUTH
// ═══════════════════════════════════════════

enum Role {
  CUSTOMER
  AGENCY
  ADMIN
  REVIEWER
}

enum AccountType {
  INDIVIDUAL
  AGENCY
}

model User {
  id          String      @id @default(uuid())
  name        String
  username    String?     @unique
  email       String      @unique
  password    String
  role        Role        @default(CUSTOMER)
  accountType AccountType @default(INDIVIDUAL)
  avatar      String?
  company     String?

  industry    String?
  goal        String?
  platforms   Json?
  contentTypes Json?

  isActive       Boolean     @default(true)
  isOnboarded    Boolean     @default(false)
  brandName      String?
  productName    String?
  website        String?
  targetAudience String?     @db.Text
  tone           String?

  requestedCustomInfluencer Boolean @default(false)

  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  chats         Chat[]
  orders        Order[]
  reviews       Review[]
  tickets       Ticket[]
  payments      Payment[]
  notifications Notification[]

  @@map("users")
}

// ═══════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════

model Notification {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?  @db.Text
  href        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}


// ═══════════════════════════════════════════
// AI INFLUENCER
// ═══════════════════════════════════════════

enum InfluencerServiceType {
  CHAT_ONLY
  VIDEO_CREATION
  POST_CREATION
  IMAGE_CREATION
}

model Influencer {
  id            String                @id @default(uuid())
  name          String
  bio           String
  avatar        String
  coverImage    String?
  locationCity    String?
  locationState   String?
  locationCountry String?
  locationAddress String?               @db.Text
  locationPincode String?
  industries    Json
  contentStyle  String
  languages     Json
  rating        Float                 @default(0)
  totalProjects Int                   @default(0)
  totalReviews  Int                   @default(0)
  isActive      Boolean               @default(true)
  hourlyRate    Float?
  systemPrompt      String                @db.Text
  topic             String?               @db.Text
  outOfTopicMessage String?               @db.Text
  voiceId           String?
  serviceType   InfluencerServiceType @default(CHAT_ONLY)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?

  portfolio InfluencerPortfolio[]
  packages  InfluencerPackage[]
  chats     Chat[]
  orders    Order[]
  reviews   Review[]
  aiConfig  AIConfig?

  @@map("influencers")
}

model AIConfig {
  id           String     @id @default(uuid())
  influencerId String     @unique
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  chatApiUrl   String?
  chatApiKey   String?
  chatModel    String?

  scriptApiUrl String?
  scriptApiKey String?
  scriptModel  String?

  voiceApiUrl  String?
  voiceApiKey  String?
  voiceModel   String?

  videoApiUrl  String?
  videoApiKey  String?
  videoModel   String?

  imageApiUrl  String?
  imageApiKey  String?
  imageModel   String?

  postApiUrl   String?
  postApiKey   String?
  postModel    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("ai_configs")
}

model InfluencerPortfolio {
  id           String   @id @default(uuid())
  influencerId String
  videoUrl     String
  thumbnailUrl String
  title        String
  description  String?
  createdAt    DateTime @default(now())

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@map("influencer_portfolios")
}

model InfluencerPackage {
  id           String      @id @default(uuid())
  influencerId String
  type         PackageType
  name         String
  price        Float
  videoCount   Int
  description  String?     @db.Text
  isMonthly    Boolean     @default(false)
  isActive     Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId, type])
  @@map("influencer_packages")
}

// ═══════════════════════════════════════════
// CHAT & MESSAGES
// ═══════════════════════════════════════════

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Chat {
  id           String   @id @default(uuid())
  customerId   String
  influencerId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer   User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  messages   Message[]
  memory     ChatMemory?

  @@unique([customerId, influencerId])
  @@map("chats")
}

model Message {
  id        String      @id @default(uuid())
  chatId    String
  role      MessageRole
  content   String      @db.Text
  imageUrl  String?     @db.Text
  createdAt DateTime    @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model ChatMemory {
  id          String   @id @default(uuid())
  chatId      String   @unique
  customerId  String
  influencerId String
  details     Json
  facts       Json
  snippets    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("chat_memories")
}

// ═══════════════════════════════════════════
// SITE SETTINGS (singleton row, id = "global")
// ═══════════════════════════════════════════

model SiteSettings {
  id           String   @id @default("global")
  chatApiUrl   String?
  chatApiKey   String?
  chatModel    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}

// ═══════════════════════════════════════════
// FAQ / PREDEFINED ANSWERS
// ═══════════════════════════════════════════

model FaqEntry {
  id        String   @id @default(uuid())
  question  String   @db.Text
  answers   Json
  keywords  String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faq_entries")
}

// ═══════════════════════════════════════════
// ORDERS
// ═══════════════════════════════════════════

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  GENERATING
  PENDING_REVIEW
  APPROVED
  DELIVERED
  REJECTED
  REFUNDED
  CANCELLED
}

enum PackageType {
  SINGLE
  PACK_5
  PACK_10
  MONTHLY_STARTER
  MONTHLY_GROWTH
  CUSTOM
}

enum DeliveryType {
  INSTANT
  QUALITY_CHECKED
}

model Order {
  id              String       @id @default(uuid())
  customerId      String
  influencerId    String
  projectBrief    Json
  package         PackageType
  deliveryType    DeliveryType @default(QUALITY_CHECKED)
  status          OrderStatus  @default(PENDING_PAYMENT)
  price           Float
  videoUrl        String?
  thumbnailUrl    String?
  aiDisclosure    Boolean      @default(true)
  reviewNotes     String?
  reviewedBy      String?
  reviewedAt      DateTime?
  deliveredAt     DateTime?
  videosOrdered   Int          @default(1)
  videosDelivered Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  customer   User       @relation(fields: [customerId], references: [id])
  influencer Influencer @relation(fields: [influencerId], references: [id])
  review     Review?
  ticket     Ticket?
  payment    Payment?

  @@map("orders")
}

// ═══════════════════════════════════════════
// REVIEWS
// ═══════════════════════════════════════════

model Review {
  id           String   @id @default(uuid())
  orderId      String   @unique
  customerId   String
  influencerId String
  rating       Float
  comment      String?  @db.Text
  createdAt    DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id])
  customer   User       @relation(fields: [customerId], references: [id])
  influencer Influencer @relation(fields: [influencerId], references: [id])

  @@map("reviews")
}

// ═══════════════════════════════════════════
// TICKETS & SUPPORT
// ═══════════════════════════════════════════

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id         String       @id @default(uuid())
  customerId String
  orderId    String?      @unique
  issue      String       @db.Text
  status     TicketStatus @default(OPEN)
  resolution String?      @db.Text
  reopenNote String?      @db.Text
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  customer User   @relation(fields: [customerId], references: [id])
  order    Order? @relation(fields: [orderId], references: [id])

  @@map("tickets")
}

// ═══════════════════════════════════════════
// PAYMENTS
// ═══════════════════════════════════════════

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @unique
  customerId      String
  stripePaymentId String?       @unique
  amount          Float
  currency        String        @default("usd")
  status          PaymentStatus @default(PENDING)
  refundedAmount  Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order    Order @relation(fields: [orderId], references: [id])
  customer User  @relation(fields: [customerId], references: [id])

  @@map("payments")
}
