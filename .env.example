# ═══════════════════════════════════════════
# GENVERSE — Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="postgresql://genverse:genverse_secret@localhost:5432/genverse?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-change-in-production"

# Anthropic (Claude API)
ANTHROPIC_API_KEY="sk-ant-..."

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Pinecone (Vector DB)
PINECONE_API_KEY="your-pinecone-api-key"

# AWS S3 / CloudFront
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="genverse-videos"
AWS_REGION="us-east-1"

# ElevenLabs (Voice Generation)
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# fal.ai (Video/Image Generation)
FAL_API_KEY="your-fal-api-key"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret"

# API URLs
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# App
PORT=4000
NODE_ENV="development"
